# Directory where temporary downloads and completed MP3 files are kept.
AUDIO_STORAGE_DIR=storage

# MP3 encoder setting accepted by FFmpeg, for example 192k or 320k.
MP3_BITRATE=320k

# Stop an FFmpeg conversion that exceeds this many seconds.
FFMPEG_TIMEOUT_SECONDS=1800

# Optional: reject downloads whose provider reports a larger size. 0 disables the limit.
MAX_DOWNLOAD_BYTES=0

# Optional explicit path to FFmpeg. This is useful when it is not on PATH.
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe

LOG_LEVEL=INFO
